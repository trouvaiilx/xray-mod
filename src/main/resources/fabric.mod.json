{
  "schemaVersion": 1,
  "id": "xray-mod",
  "version": "${version}",
  "name": "X-Ray",
  "description": "Customizable X-ray for Fabric. Fully compliant with Modrinth Rule 3.3.a (requires server-side opt-in on multiplayer). Requires Sodium for client rendering visuals.",
  "authors": [
    "trouvaiilx"
  ],
  "contact": {
    "homepage": "https://github.com/trouvaiilx/xray-mod",
    "sources": "https://github.com/trouvaiilx/xray-mod",
    "issues": "https://github.com/trouvaiilx/xray-mod/issues",
    "funding": "https://ko-fi.com/trouvaiilx"
  },
  "license": "MIT",
  "icon": "assets/xray-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.trouvaiilx.xray.XrayCommon"
    ],
    "client": [
      "io.github.trouvaiilx.xray.XrayClient"
    ],
    "server": [
      "io.github.trouvaiilx.xray.server.XrayServer"
    ]
  },
  "mixins": [
    "xray-sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "26.2",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": ["client"]
    }
  }
}
